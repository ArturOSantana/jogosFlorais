rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Troque pelos e-mails dos administradores (os mesmos criados em Authentication).
    function admin() {
      return request.auth != null
        && request.auth.token.email in ['admin1@exemplo.com', 'admin2@exemplo.com'];
    }
    match /ajustes/{id} {
      allow read: if true;
      allow create: if admin() && request.resource.data.v is number
        && request.resource.data.t in ['pp','sl','gg'];
      allow delete: if admin();
    }
    match /atas/{id}    { allow read: if true; allow write: if admin(); }
    match /equipes/{id} { allow read: if true; allow write: if admin(); }
  }
}
