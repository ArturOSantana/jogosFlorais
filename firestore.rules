rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Substitua pelos e-mails autorizados, iguais aos usuários de Authentication.
    function admin() {
      return request.auth != null
        && request.auth.token.email in ['admin1@exemplo.com', 'admin2@exemplo.com'];
    }
    match /ajustes/{id} {
      allow read: if true;
      allow create: if admin() && request.resource.data.v is number
        && request.resource.data.t in ['pp','sl','gg'];
      allow delete: if admin();
    }
    match /auditoriaPontos/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actor == request.auth.token.email;
      allow update, delete: if false;
    }
    match /atas/{id}    {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /avaliacoes/{id} {
      allow read: if true;
      allow create: if admin()
        && id == request.resource.data.activityId + '__' + request.resource.data.juizId;
      allow update: if admin()
        && id == request.resource.data.activityId + '__' + request.resource.data.juizId
        && resource.data.juizId == request.resource.data.juizId
        && resource.data.activityId == request.resource.data.activityId;
      allow delete: if admin();
    }
    match /modalidades/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /megasenha/{id} {
      allow get: if id == 'state';
      allow list: if false;
      allow write: if id == 'state' && admin();
    }
    match /equipes/{id} { allow read: if true; allow write: if admin(); }
    match /config/{id}  { allow read: if true; allow write: if admin(); }
  }
}
